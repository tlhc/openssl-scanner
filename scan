#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
src_dir="$script_dir/src"
show_python=0

arg_count=$#
while [ "$arg_count" -gt 0 ]; do
  arg=$1
  shift
  arg_count=$((arg_count - 1))
  if [ "$arg" = "-V" ] || [ "$arg" = "--verbose-launcher" ]; then
    show_python=1
    continue
  fi
  set -- "$@" "$arg"
done

can_run_scanner() {
  candidate="$1"
  "$candidate" - <<'PY' >/dev/null 2>&1
import os
import sys
sys.path.insert(0, os.environ["OPENSSL_SCANNER_SRC_DIR"])
import openssl_scanner._vendor.tree_sitter as tree_sitter
import openssl_scanner._vendor.tree_sitter_c as tree_sitter_c
import openssl_scanner._vendor.tree_sitter_cpp as tree_sitter_cpp
import openssl_scanner._vendor.tree_sitter_rust as tree_sitter_rust
if not hasattr(tree_sitter, "Parser"):
    raise SystemExit(1)
if not hasattr(tree_sitter_c, "language"):
    raise SystemExit(1)
if not hasattr(tree_sitter_cpp, "language"):
    raise SystemExit(1)
if not hasattr(tree_sitter_rust, "language"):
    raise SystemExit(1)
PY
}

pick_python() {
  for candidate in \
    /opt/homebrew/opt/python@3.14/bin/python3.14 \
    /opt/homebrew/bin/python3.14 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /usr/local/opt/python@3.14/bin/python3.14 \
    /usr/local/bin/python3.14 \
    /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12 \
    /usr/bin/python3.14 \
    /usr/bin/python3.13 \
    /usr/bin/python3.12 \
    /usr/bin/python3 \
    "$(command -v python3.14 2>/dev/null || true)" \
    "$(command -v python3.13 2>/dev/null || true)" \
    "$(command -v python3.12 2>/dev/null || true)" \
    "$(command -v python3 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      if OPENSSL_SCANNER_SRC_DIR="$src_dir" can_run_scanner "$candidate"; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done
  return 1
}

python_bin=$(pick_python) || {
  printf '%s\n' "scan: no compatible Python interpreter found for vendored tree-sitter runtime" >&2
  exit 1
}

if [ "$show_python" -eq 1 ]; then
  printf '%s\n' "scan launcher python: $python_bin" >&2
fi

export PYTHONPATH="$src_dir${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m openssl_scanner "$@"
