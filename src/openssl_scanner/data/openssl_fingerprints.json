        "X509v3 Name Constraints",
        "X509v3 Policy Constraints",
        "X509v3 Inhibit Any Policy",
        "X509v3 Delta CRL Indicator",
        "X509v3 Freshest CRL"
      ]
    },
    "T2A_oid_names": {
      "per_point": 0.7,
      "max_points": 20,
      "description": "OID short names from obj_dat.c (shared across all variants)",
      "strings": [
        "prime256v1",
        "secp384r1",
        "secp521r1",
