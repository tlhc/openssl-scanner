      "library": "BoringSSL",
      "per_point": 1.0,
      "max_points": 6,
      "description": "BoringSSL-unique TLS error reason strings (ALPS, Channel ID, ECH) never present in OpenSSL",
      "strings": [
        "ECH_REJECTED",
        "NO_COMMON_SIGNATURE_ALGORITHMS",
        "CHANNEL_ID_NOT_P256",
        "CHANNEL_ID_SIGNATURE_INVALID",
