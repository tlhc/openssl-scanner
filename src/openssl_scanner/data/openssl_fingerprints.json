      "per_point": 0.7,
      "max_points": 7,
      "match_mode": "substring",
      "description": "Shared crypto/* source path suffixes via __FILE__ (substring match for BoringSSL prefix variants)",
      "strings": [
        "crypto/asn1/a_bitstr.c",
        "crypto/asn1/a_int.c",
        "crypto/asn1/a_mbstr.c",
        "crypto/asn1/a_object.c",
